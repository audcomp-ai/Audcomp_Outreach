# ── Supabase ────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...          # service_role key (server-side only)

# ── Apify ────────────────────────────────────────────────────────────────────
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# ── Inngest ──────────────────────────────────────────────────────────────────
# Get from: https://app.inngest.com → your app → API Keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=                         # set to "1" for local dev server

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token: https://api.slack.com/apps → your app → OAuth & Permissions
# Signing secret: your app → Basic Information
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_LEADS_CHANNEL_ID=              # Channel ID for scrape notifications (e.g. C0123456789)
SLACK_CAMPAIGNS_CHANNEL_ID=          # Channel ID for campaign review notifications

# ── AI ───────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Your deployed Vercel URL — used for Slack campaign action buttons
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
